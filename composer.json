{
    "name": "xammie/mailbook-demo",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.15.2",
        "laravel/framework": "^13.23.0",
        "laravel/tinker": "^3.0.2",
        "league/commonmark": "^2.8.3",
        "sentry/sentry-laravel": "^4.27.0",
        "tempest/highlight": "^2.27.0",
        "xammie/mailbook": "^1.12.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.0",
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.30.2",
        "laravel/sail": "^1.64",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^12.5.33",
        "rector/rector": "^2.5.9",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@composer bump"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
